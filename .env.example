# Used by the Playwright "tracking" project (npm run test:tracking).
# The CLI (npm run tracking -- ...) takes the same values as flags instead.

# Either a URL...
TRACKING_URL=https://example.com
# ...or a config file / site name from configs/sites/
# TRACKING_CONFIG=example-com

# Optional overrides
# TRACKING_TYPE=lander          # lander | quiz | chatquiz | auto
# TRACKING_PROVIDER=ringba      # ringba | callgrid | none | auto
# TRACKING_HEADED=1
# TRACKING_DEBUG=1

# Disable colored console output
# NO_COLOR=1
